# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres. On Vercel use the pooled connection string (host contains "-pooler").
DATABASE_URL=
# The direct (non-pooled) connection string, used by `npm run db:migrate`.
DATABASE_URL_DIRECT=

# Neon Auth: Neon console › your project › Auth › enable, then copy the Auth URL.
NEON_AUTH_BASE_URL=
# Any random string of 32+ characters, e.g. `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=

# Where the app runs. Used to build OAuth callback and report links.
APP_URL=http://localhost:3000

# Encrypts stored platform tokens. 32 random bytes as base64: `openssl rand -base64 32`.
TOKEN_ENCRYPTION_KEY=

# Google OAuth for GA4 (Google Cloud › APIs & Services › Credentials › OAuth client, type "Web application").
# Authorised redirect URI: {APP_URL}/api/integrations/google/callback
# Enable the "Google Analytics Admin API" and "Google Analytics Data API" in the same project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta: a Meta for Developers app (development mode is fine) and a system user token
# from your Business Manager with the ads_read permission.
META_APP_ID=
META_APP_SECRET=

# Claude writes the reports.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Resend sends reports and alerts. FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=AI Ads Analyst <reports@example.com>

# Vercel Cron sends this as a bearer token to /api/cron/*.
CRON_SECRET=
